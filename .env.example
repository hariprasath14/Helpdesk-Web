# helpdesk-web build settings. Copy to .env for local development: cp .env.example .env
# VITE_* values are baked into the build (Vite), so they are public: never put secrets here.
# On AWS the pipeline sets them per environment.

# Where the API is. Leave empty: the app calls /api on its own address, which the dev server
# forwards to helpdesk-api (npm run dev there) and CloudFront forwards on AWS.
VITE_API_URL=
# The app's domain; each workspace is a subdomain of it (acme.localhost:5173 locally).
VITE_APP_DOMAIN=localhost
# Dev server only, never in the build: where it forwards /api, /health and /docs.
API_PROXY_TARGET=http://localhost:4000

# Design preview pages at /design (components, states, the app shell with sample data).
# true locally and in dev for reviewing UI; false in prod.
VITE_DESIGN_PREVIEW=true

# Brand theme for this deployment: forest (default) or indigo.
# Changes the palette, logo, icons and phone address bar colour. See src/brands.ts.
VITE_BRAND=forest

# The demo build (sample data in the browser, no API): set only by .env.demo, never here.
# VITE_DEMO=false
