# The dev server's real names, read by deploy.sh. Copy to dev.local.env (not
# committed) and fill it in; the owner's values are in docs/real-names.local.md.
HELPDESK_DEV_HOST=dev.helpdesk.example.com
HELPDESK_DEV_DOMAIN=dev.helpdesk.example.com
HELPDESK_DEV_DNS_ZONE=helpdesk.example.com
HELPDESK_DEV_SSH_KEY=$HOME/.ssh/helpdesk-dev.pem
