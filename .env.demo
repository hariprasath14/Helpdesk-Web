# The demo build (npm run build:demo, npm run dev:demo): no API or server. The app answers its own
# API calls from sample data in the browser (src/demo) and runs on whatever address hosts it, so
# VITE_API_URL and VITE_APP_DOMAIN are not used. Committed: nothing here is secret.
VITE_DEMO=true
VITE_DESIGN_PREVIEW=false
VITE_BRAND=forest
